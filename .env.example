# ─────────────────────────────────────────────────────────────────────────────
# PrithviNet — Environment Variables
# Copy this file to .env (backend) and .env.local (frontend) and fill in values.
# Required variables will prevent the app from starting if missing.
# ─────────────────────────────────────────────────────────────────────────────


# ─── DATABASE ────────────────────────────────────────────────────────────────

# Async PostgreSQL URL (used by FastAPI / SQLAlchemy async engine)
# Required — backend will not start without this
DATABASE_URL=postgresql+asyncpg://postgres:secret@localhost:5432/prithvinet

# Sync PostgreSQL URL (used by Alembic migrations and Celery)
# Required — same host/db as DATABASE_URL but with psycopg2 driver
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:secret@localhost:5432/prithvinet


# ─── REDIS ───────────────────────────────────────────────────────────────────

# Redis URL — used for WebSocket pub/sub and API response caching
# Required
REDIS_URL=redis://localhost:6379/0

# Celery broker — must point to Redis (or RabbitMQ)
# Required
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend — stores task results
# Required
CELERY_RESULT_BACKEND=redis://localhost:6379/0


# ─── JWT AUTH ────────────────────────────────────────────────────────────────

# Secret key used to sign and verify JWT tokens
# Required — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_secret_key

# JWT signing algorithm (optional — default: HS256)
JWT_ALGORITHM=HS256

# Access token lifetime in minutes (optional — default: 60)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Refresh token lifetime in days (optional — default: 30)
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30


# ─── AI / LLM KEYS ───────────────────────────────────────────────────────────

# OpenAI API key — used by the AI Copilot and forecast narrative service
# Optional — copilot degrades gracefully without this
OPENAI_API_KEY=sk-...

# OpenAI model for main copilot responses (optional — default: gpt-4o)
OPENAI_MODEL=gpt-4o

# OpenAI fallback model when quota is exceeded (optional — default: gpt-3.5-turbo)
OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# OpenRouter API key — used as an alternative to OpenAI (supports Claude, etc.)
# Optional — falls back to OpenAI if not set
OPENROUTER_API_KEY=sk-or-...

# OpenRouter model identifier (optional — default: anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Your site URL sent in OpenRouter request headers (optional)
OPENROUTER_SITE_URL=http://localhost:3000

# App name sent in OpenRouter request headers (optional)
OPENROUTER_APP_NAME=PrithviNet

# Google Gemini API key — alternative LLM backend and AI Studio injection
# Optional — AI Studio injects this automatically at runtime
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini model (optional — default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash


# ─── IOT SIMULATOR ───────────────────────────────────────────────────────────

# Backend URL for the IoT simulator to POST readings to
# Optional — default: http://127.0.0.1:8000
BACKEND_URL=http://localhost:8000

# Path to the simulator's persistent state file (survives restarts)
# Optional — default: /tmp/prithvinet_sim_state.json
# In Docker this should be inside the mounted simulator_state volume
IOT_STATE_FILE=/sim_state/prithvinet_sim_state.json


# ─── DATA IMPORT SCRIPTS ─────────────────────────────────────────────────────

# data.gov.in API key — used by fetch_official_datasets.py and sync_govapi scripts
# Optional — public datasets work without a key; rate limits apply
GOVAPI_KEY=your_data_gov_in_api_key_here

# Anthropic API key — used by scripts that call Claude directly (not via OpenRouter)
# Optional
ANTHROPIC_API_KEY=sk-ant-...

# Override path to water quality CSV (optional — default: data/water_quality.csv)
WATER_DATASET_PATH=

# Override path to air quality CSV (optional — default: data/air_quality.csv)
AIR_DATASET_PATH=

# Extra dataset URLs in JSON format for fetch_official_datasets.py (optional)
OFFICIAL_DATASETS_JSON=


# ─── FRONTEND (Vite — prefix with VITE_) ────────────────────────────────────
# These are only needed in .env.local — they are embedded at build time by Vite

# Backend REST API base URL
# Optional — default: http://localhost:8000
VITE_API_URL=http://localhost:8000

# WebSocket base URL
# Optional — default: ws://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Bytez API key — proxies Claude/GPT-4o for frontend AI features
# Required for frontend AI CoPilot and forecast insight
VITE_BYTEZ_API_KEY=YOUR_BYTEZ_API_KEY_HERE

# LLM model for Bytez frontend AI (optional — default: anthropic/claude-opus-4-5)
VITE_BYTEZ_MODEL=anthropic/claude-opus-4-5

# Set true to point bytez.js to local Docker host (optional — default: false)
VITE_BYTEZ_LOCAL_DEV=false


# ─── AI STUDIO (injected automatically at runtime) ───────────────────────────

# Hosted app URL (Cloud Run service URL — injected by AI Studio automatically)
APP_URL=MY_APP_URL
