# ─────────────────────────────────────────────────────────────
#  PrithviNet – Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite — prefix VITE_) ──────────────────────────
VITE_API_URL="http://localhost:8000"
VITE_WS_URL="ws://localhost:8000"

# Bytez / AI forecast (frontend)
# Required: Set your Bytez API key here.
VITE_BYTEZ_API_KEY="YOUR_BYTEZ_API_KEY"
# Optional: Override Bytez model. Defaults to anthropic/claude-opus-4-5.
VITE_BYTEZ_MODEL="anthropic/claude-opus-4-5"
# Optional: Set true to point bytez.js to local Docker host mode.
VITE_BYTEZ_LOCAL_DEV="false"

# Gemini (optional — AI Studio auto-injects at runtime)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ── Backend (FastAPI / Python) ───────────────────────────────
# PostgreSQL (TimescaleDB) connection string
DATABASE_URL=postgresql+asyncpg://prithvinet:prithvinet@localhost:5432/prithvinet
SYNC_DATABASE_URL=postgresql+psycopg2://prithvinet:prithvinet@localhost:5432/prithvinet

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Secret key for JWT
SECRET_KEY=change-me-to-a-random-secret-in-production

# ── data.gov.in API Key ─────────────────────────────────────
# Same key works for ALL three APIs below (air, water, noise).
# Get from: data.gov.in → Login → My Account → API Key (free)
GOVAPI_KEY=your_data_gov_in_api_key_here

# API 1 — Air Quality (already integrated)
# URL: https://api.data.gov.in/resource/3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69
# Filter: state=Chhattisgarh | Updates: hourly

# API 2 — Water Quality NWMP (integrate now)
# URL: https://api.data.gov.in/resource/9c6a4e06-c1b3-4b83-8e4d-60b499723d98
# Backup: https://api.data.gov.in/resource/6f463a32-7c89-4aac-8dd1-45e41b40af35
# Filter: state=Chhattisgarh | Updates: daily

# API 3 — Noise NANMN pattern reference (metro cities only — CG not covered)
# URL: https://api.data.gov.in/resource/cpcb-nanmn-noise-monitoring
# Filter: city=Lucknow,zone_type=Industrial | Used as pattern only

# ── AI Forecast / Insights (OpenRouter) ─────────────────────
# Get a free key at https://openrouter.ai/
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=PrithviNet

# ── OpenWeatherMap — backup for air if data.gov.in is down ──
OWM_KEY=your_openweathermap_key_here
# Get from: openweathermap.org → Sign up → API keys (free tier)

# ── Anthropic — AI Copilot ──────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_key_here
# Get from: console.anthropic.com → API Keys
