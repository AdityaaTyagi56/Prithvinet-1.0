# ─────────────────────────────────────────────────────────────
#  PrithviNet – Environment Variables
# ─────────────────────────────────────────────────────────────

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Bytez / AI forecast (frontend)
VITE_BYTEZ_API_KEY=322ce67e8fed1880020a217b10660aa6
VITE_BYTEZ_MODEL=anthropic/claude-opus-4-6
VITE_BYTEZ_LOCAL_DEV=false

# ── Backend (FastAPI / Python) ───────────────────────────────
# PostgreSQL (TimescaleDB) connection string
DATABASE_URL=postgresql+asyncpg://prithvinet:prithvinet@localhost:5432/prithvinet

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── Government Open Data API ─────────────────────────────────
# Register at https://api.data.gov.in/ to get your free API key.
# Dataset: CPCB Air Quality (resource 3b01bcb8-0b14-4abf-b6f2-c1bfd384ba69)
# Steps: 1) Go to https://api.data.gov.in/  2) Sign up / login
#         3) Search "CPCB Air Quality"  4) Click "Get API"  5) Copy key below
GOVAPI_KEY=579b464db66ec23bdd000001910a2022338845f77478d8638905eb0c

# ── AI Forecast / Insights (OpenRouter) ─────────────────────
# Get a free key at https://openrouter.ai/
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=PrithviNet

# ── Secret key for JWT  ──────────────────────────────────────
SECRET_KEY=change-me-to-a-random-secret-in-production
